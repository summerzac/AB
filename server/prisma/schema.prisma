generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANUFACTURER
  BUYER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  LABEL_PURCHASED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role
  createdAt           DateTime             @default(now())
  manufacturerProfile ManufacturerProfile?
  addresses           Address[]
  conversations       Conversation[]       @relation("BuyerConversations")
  messages            Message[]
  orders              Order[]
}

model ManufacturerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  description String?
  logoUrl     String?
  country     String?
  verified    Boolean   @default(false)
  shipFromAddressId String?  @unique
  shipFromAddress   Address? @relation("ShipFromAddress", fields: [shipFromAddressId], references: [id])
  createdAt   DateTime  @default(now())
  products      Product[]
  conversations Conversation[]
  orders        Order[]
}

model Address {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  street1      String
  street2      String?
  city         String
  state        String
  zip          String
  country      String   @default("US")
  phone        String?
  createdAt    DateTime @default(now())
  manufacturer ManufacturerProfile? @relation("ShipFromAddress")
  orders       Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id             String    @id @default(cuid())
  manufacturerId String
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  title          String
  description    String
  minOrderQty    Int       @default(1)
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  images         ProductImage[]
  variants       ProductVariant[]
  conversations  Conversation[]

  @@index([categoryId])
  @@index([manufacturerId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  attributes Json
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  stock      Int      @default(0)
  weightOz   Float    @default(16)
  lengthIn   Float    @default(6)
  widthIn    Float    @default(6)
  heightIn   Float    @default(6)
  createdAt  DateTime @default(now())
  orderItems OrderItem[]

  @@index([productId])
}

model Conversation {
  id             String    @id @default(cuid())
  buyerId        String
  buyer          User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  manufacturerId String
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]

  @@unique([buyerId, manufacturerId, productId])
  @@index([manufacturerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
}

model Order {
  id                String      @id @default(cuid())
  buyerId           String
  buyer             User        @relation(fields: [buyerId], references: [id])
  manufacturerId    String
  manufacturer      ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  status            OrderStatus @default(PENDING_PAYMENT)
  shippingAddressId String
  shippingAddress   Address     @relation(fields: [shippingAddressId], references: [id])
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingCost      Decimal?    @db.Decimal(10, 2)
  total             Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  shipment          Shipment?

  @@index([buyerId])
  @@index([manufacturerId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
}

model Shipment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("easypost")
  simulated         Boolean  @default(false)
  easypostShipmentId String?
  easypostRateId    String?
  carrier           String?
  service           String?
  rateAmount        Decimal? @db.Decimal(10, 2)
  trackingCode      String?
  trackingUrl       String?
  labelUrl          String?
  status            String   @default("rate_quoted")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

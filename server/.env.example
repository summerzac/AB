DATABASE_URL="postgresql://ab_app:ab_app_pw@localhost:5432/ab_marketplace"
PORT=4000
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:3000"

# EasyPost API key (get a free test key at https://www.easypost.com/ -> Account -> API Keys,
# test keys start with "EZTK"; production keys start with "EZAK").
# If left blank, the shipping service automatically falls back to a local
# simulated carrier so the app still runs end-to-end without any account.
EASYPOST_API_KEY=""
